# Copy these into Streamlit Cloud -> your app -> Settings -> Secrets.
# Every line is optional. NEVER commit a real secrets.toml to GitHub.

# Google Gemini key for AI commentary (https://aistudio.google.com/apikey)
# GEMINI_API_KEY = "paste-your-key-here"
# GEMINI_MODEL = "gemini-3.8-flash"

# Shared access code to keep a private demo private
# APP_ACCESS_CODE = "choose-a-long-code"

# Supabase / PostgreSQL connection (Session pooler URI). Leave out to use the built-in demo database.
# DATABASE_URL = "postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:5432/postgres"
